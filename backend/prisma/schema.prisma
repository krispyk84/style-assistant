generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutfitTier {
  BUSINESS
  SMART_CASUAL
  CASUAL
}

enum AnalysisVerdict {
  WORKS_GREAT
  WORKS_OKAY
  DOESNT_WORK
}

enum UploadedImageCategory {
  ANCHOR_ITEM
  CANDIDATE_PIECE
  SELFIE
}

model UserProfile {
  id                   String               @id @default(cuid())
  supabaseUserId       String?
  name                 String               @default("")
  gender               String
  heightCm             Float
  weightKg             Float
  fitPreference        String
  stylePreference      String
  budget               String
  hairColor            String
  skinTone             String
  summerBottomPreference String           @default("prefer-trousers")
  temperatureUnit      String              @default("celsius")
  bodyType             String?
  weightDistribution   String?
  fitTendency          String?
  notes                String?
  onboardingCompleted  Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  outfitRequests       OutfitRequest[]
  compatibilityChecks  CompatibilityCheck[]
  selfieReviews        SelfieReview[]

  @@index([supabaseUserId])
}

model OutfitRequest {
  id                    String         @id
  profileId             String?
  supabaseUserId        String?
  anchorImageId         String?
  anchorItemDescription String
  anchorImageUrl        String?
  photoPending          Boolean        @default(false)
  selectedTiers         OutfitTier[]
  weatherContext        Json?
  promptVersion         String         @default("mock-v1")
  status                String         @default("completed")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  profile               UserProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  anchorImage           UploadedImage? @relation("AnchorItemImage", fields: [anchorImageId], references: [id], onDelete: SetNull)
  result                OutfitResult?

  @@index([supabaseUserId])
}

model OutfitResult {
  id             String       @id @default(cuid())
  requestId      String       @unique
  status         String
  provider       String       @default("mock")
  rawResponse    Json?
  generatedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  request        OutfitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tierResults    TierResult[]
}

model TierResult {
  id                String      @id @default(cuid())
  outfitResultId    String
  tier              OutfitTier
  title             String
  anchorItem        String
  keyPieces         Json
  shoes             Json
  accessories       Json
  fitNotes          Json
  whyItWorks        String
  stylingDirection  String
  detailNotes       Json
  sketchStatus      String      @default("pending")
  sketchImageUrl    String?
  sketchStorageKey  String?
  sketchMimeType    String?
  sketchImageData   Bytes?
  sketchErrorCode   String?
  sketchErrorMessage String?
  variantIndex      Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  outfitResult      OutfitResult @relation(fields: [outfitResultId], references: [id], onDelete: Cascade)

  @@unique([outfitResultId, tier])
}

model CompatibilityCheck {
  id                String           @id @default(cuid())
  profileId         String?
  imageId           String?
  imageUrl          String?
  imageKey          String?
  imageFilename     String?
  imageMimeType     String?
  imageWidth        Int?
  imageHeight       Int?
  imageSizeBytes    Int?
  verdict           AnalysisVerdict
  stylistNotes      Json
  suggestedChanges  Json
  rawResponse       Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  profile           UserProfile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  image             UploadedImage?   @relation("CompatibilityImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model SelfieReview {
  id                String           @id @default(cuid())
  profileId         String?
  imageId           String?
  imageUrl          String?
  imageKey          String?
  imageFilename     String?
  imageMimeType     String?
  imageWidth        Int?
  imageHeight       Int?
  imageSizeBytes    Int?
  verdict           AnalysisVerdict
  stylistNotes      Json
  suggestedChanges  Json
  rawResponse       Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  profile           UserProfile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  image             UploadedImage?   @relation("SelfieImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model UploadedImage {
  id                    String                 @id @default(cuid())
  category              UploadedImageCategory
  storageProvider       String
  storageKey            String                 @unique
  publicUrl             String
  originalFilename      String?
  mimeType              String?
  sizeBytes             Int?
  width                 Int?
  height                Int?
  imageData             Bytes?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  anchorItemRequests    OutfitRequest[]        @relation("AnchorItemImage")
  compatibilityChecks   CompatibilityCheck[]   @relation("CompatibilityImage")
  selfieReviews         SelfieReview[]         @relation("SelfieImage")
}

model ClosetItem {
  id               String   @id @default(cuid())
  supabaseUserId   String?
  title            String
  brand            String   @default("")
  size             String   @default("")
  category         String   @default("Clothing")
  uploadedImageUrl String?
  sketchImageUrl   String?
  sketchStorageKey String?
  sketchMimeType   String?
  sketchImageData  Bytes?
  sketchStatus     String   @default("failed")
  savedAt          DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ── Design metadata ──────────────────────────────────────────────────────
  subcategory      String?
  primaryColor     String?
  colorFamily      String?
  material         String?
  formality        String?
  silhouette       String?
  season           String?
  weight           String?
  pattern          String?
  notes            String?

  // ── Personal fit ─────────────────────────────────────────────────────────
  fitStatus        String?

  // ── Sunglasses-specific ───────────────────────────────────────────────────
  lensShape        String?
  frameColor       String?

  // ── Usage counters ────────────────────────────────────────────────────────
  timesAnchored    Int       @default(0)
  lastAnchoredAt   DateTime?
  matchCount       Int       @default(0)

  @@index([supabaseUserId])
}

model ClosetSketchJob {
  id                 String   @id @default(cuid())
  status             String   @default("pending")
  sketchImageUrl     String?
  sketchStorageKey   String?
  sketchMimeType     String?
  sketchImageData    Bytes?
  sketchErrorCode    String?
  sketchErrorMessage String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model HaircutSession {
  id               String          @id @default(cuid())
  supabaseUserId   String
  headshotImageUrl String
  // Location/gender-derived, snapshotted at session-create time so "see more" batches keep sourcing from the same trend profile.
  hemisphere       String?
  region           String?
  fashionGender    String?
  savedAt          DateTime?
  chosenOptionId   String?
  guideData        Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  options          HaircutOption[]

  @@index([supabaseUserId])
  @@index([supabaseUserId, savedAt])
}

model HaircutOption {
  id              String         @id @default(cuid())
  sessionId       String
  styleKey        String
  styleLabel      String
  styleSummary    String
  status          String         @default("pending")
  imageStorageKey String?
  imageMimeType   String?
  imageData       Bytes?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  session         HaircutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AiUsageEntry {
  id             String   @id @default(cuid())
  supabaseUserId String
  monthKey       String
  feature        String
  model          String
  costUsd        Float
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())

  @@index([supabaseUserId, monthKey])
}

model SavedTrip {
  id             String   @id @default(cuid())
  supabaseUserId String
  tripId         String   // client-generated, used for upsert dedup
  destination    String
  country        String
  departureDate  String   // YYYY-MM-DD
  returnDate     String   // YYYY-MM-DD
  travelParty    String
  climateLabel   String
  styleVibe      String
  purposes       Json     // string[]
  activities     String?
  dressCode      String?
  days           Json     // TripOutfitDay[] — full client state including sketches
  savedAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supabaseUserId, tripId])
  @@index([supabaseUserId])
}

// ── Trip Planning ─────────────────────────────────────────────────────────────

model TripPlan {
  id             String       @id @default(cuid())
  supabaseUserId String
  // Destination
  destination    String
  country        String
  // Dates
  departureDate  String                    // YYYY-MM-DD
  returnDate     String                    // YYYY-MM-DD
  numDays        Int
  // Trip details
  travelParty    String
  purposes       Json                      // string[]
  // Climate
  climateLabel   String
  styleVibe      String
  // Smart packing
  willSwim       Boolean      @default(false)
  fancyNights    Boolean      @default(false)
  workoutClothes Boolean      @default(false)
  laundryAccess  String       @default("Unsure")
  shoesCount     String       @default("2")
  carryOnOnly    Boolean      @default(false)
  activities     String?
  dressCode      String?
  specialNeeds   String?
  // Anchor selection
  anchorMode     String?                   // guided | auto | manual
  // Lifecycle
  status         String       @default("draft")  // draft | generating | generated
  tripId         String?                   // set after generation
  anchors        TripAnchor[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([supabaseUserId])
}

model TripAnchor {
  id              String    @id @default(cuid())
  tripPlanId      String
  tripPlan        TripPlan  @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  supabaseUserId  String
  slotId          String?                // guided-mode slot reference
  label           String
  category        String
  source          String                 // closet | camera | library | ai_suggested
  closetItemId    String?
  uploadedImageId String?
  imageUrl        String?
  rationale       String?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tripPlanId])
  @@index([supabaseUserId])
}

model StyleGuideDocument {
  id                  String   @id @default(cuid())
  name                String
  sourceFilename      String
  sourceMimeType      String?
  sourcePath          String?
  processedTextPath   String?
  openAiFileId        String?
  vectorStoreId       String
  retrievalProvider   String   @default("openai")
  status              String   @default("ready")
  active              Boolean  @default(true)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Snapshot of a closet-analysis result. Used to keep the score stable across
/// runs against the same closet composition: when `closetHash` matches the
/// latest snapshot for the user, the cached scores are returned and only the
/// stylist advisory is regenerated. When the hash differs, a fresh analysis
/// is run, persisted, and the delta vs the previous snapshot is reported.
///
/// `itemSignatures` is a sorted projection of the closet at analysis time
/// (one entry per item, "category|name") so the delta summary can name which
/// pieces were added or removed without re-querying old item rows.
model ClosetAnalysisSnapshot {
  id                 String   @id @default(cuid())
  supabaseUserId     String
  closetHash         String
  itemCount          Int
  totalScore         Int
  formalityRange     Int
  colorVersatility   Int
  seasonalCoverage   Int
  layeringOptions    Int
  occasionCoverage   Int
  summary            String
  deficientCategory  String
  excessCategory     String
  itemSignatures     String[]
  createdAt          DateTime @default(now())

  @@index([supabaseUserId, createdAt(sort: Desc)])
}

// One row per outfit produced by "Generate 5 Outfits" (base outfits and
// variations alike). Serves two purposes: recent itemIds feed a variety
// signal into the next generation's prompt (avoid repeating the same
// pieces), and feedback ('love'/'hate') feeds a preference signal — both
// read back by closet-outfits.service.ts when building future prompts.
model ClosetOutfitFeedback {
  id             String   @id @default(cuid())
  supabaseUserId String
  formality      String
  title          String
  itemIds        Json
  feedback       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supabaseUserId, createdAt(sort: Desc)])
  @@index([supabaseUserId, feedback])
}

/// One row per (season, year, fashionGender, hemisphere) — Gemini-sourced
/// current-trend intelligence, refreshed at most once per season per that
/// key (see seasonal-trends.service.ts). `status` lets a validation failure
/// be logged/inspected without ever being served: only "valid" rows are
/// returned by findCurrent/findMostRecent, so a bad Gemini response can never
/// clobber a previously-good profile.
model SeasonalTrendProfile {
  id            String   @id @default(cuid())
  season        String
  year          Int
  fashionGender String
  hemisphere    String
  region        String?
  schemaVersion Int      @default(1)
  status        String   @default("valid")
  business      Json
  smartCasual   Json
  casual        Json
  invalidReason String?
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([season, year, fashionGender, hemisphere])
  @@index([fashionGender, hemisphere, status, createdAt(sort: Desc)])
}

// Seasonal top-20 haircut trend list, one profile per fashionGender —
// mirrors SeasonalTrendProfile's menswear/womenswear split as well as its
// status/invalidReason "never overwrite a valid profile with a bad one"
// guarantee.
model HaircutTrendProfile {
  id            String   @id @default(cuid())
  season        String
  year          Int
  fashionGender String
  hemisphere    String
  region        String?
  schemaVersion Int      @default(1)
  status        String   @default("valid")
  styles        Json
  invalidReason String?
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([season, year, fashionGender, hemisphere])
  @@index([fashionGender, hemisphere, status, createdAt(sort: Desc)])
}

// A sketch generated for one seasonal fashion trend, keyed by fashionGender +
// a normalized trend name so a trend that recurs in a later season's profile
// (Gemini names it identically because it's genuinely still current) reuses
// its existing sketch rather than regenerating — "persist through the season
// and into future seasons if the trend persists". lastSeenAt is refreshed
// each time a freshly generated profile still contains this trend name.
model TrendSketch {
  id               String    @id @default(cuid())
  fashionGender    String
  trendNameKey     String
  trendName        String
  formality        String
  // Full descriptive fields needed to (re)build the sketch prompt, persisted
  // so a stuck/failed sketch can be retried purely from this row — without
  // depending on the original in-memory trend list that requested it still
  // being around (it won't be, across a server restart).
  trendData        Json?
  status           String    @default("pending")
  sketchStorageKey String?
  sketchMimeType   String?
  sketchImageData  Bytes?
  errorCode        String?
  errorMessage     String?
  firstGeneratedAt DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([fashionGender, trendNameKey])
  @@index([fashionGender, status])
}

// Per-user thumbs up/down on a seasonal fashion trend — a soft personal bias
// applied on top of the (shared, global) trend ranking when building outfit-
// generation prompts. Deliberately NOT shared across users: this is a
// personal preference, not a correction to the trend data itself.
model TrendFeedback {
  id             String   @id @default(cuid())
  supabaseUserId String
  fashionGender  String
  trendNameKey   String
  feedback       String // 'up' | 'down'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supabaseUserId, fashionGender, trendNameKey])
  @@index([supabaseUserId, fashionGender])
}

// Seasonal top-10 colour palette, one profile per fashionGender — mirrors
// SeasonalTrendProfile's shape/guarantees exactly (shared across all users,
// generated once per season, status/invalidReason "never overwrite a valid
// profile with a bad one").
model SeasonalColorPalette {
  id            String   @id @default(cuid())
  season        String
  year          Int
  fashionGender String
  hemisphere    String
  region        String?
  schemaVersion Int      @default(1)
  status        String   @default("valid")
  colors        Json
  invalidReason String?
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([season, year, fashionGender, hemisphere])
  @@index([fashionGender, hemisphere, status, createdAt(sort: Desc)])
}

// A sketch generated for one seasonal colour swatch — mirrors TrendSketch
// exactly (keyed by fashionGender + normalized colour name, persists through
// the season and into future seasons if the colour recurs).
model ColorSwatchSketch {
  id               String    @id @default(cuid())
  fashionGender    String
  colorNameKey     String
  colorName        String
  // Full descriptive fields needed to (re)build the swatch prompt, persisted
  // so a stuck/failed sketch can be retried purely from this row.
  colorData        Json?
  status           String    @default("pending")
  sketchStorageKey String?
  sketchMimeType   String?
  sketchImageData  Bytes?
  errorCode        String?
  errorMessage     String?
  firstGeneratedAt DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([fashionGender, colorNameKey])
  @@index([fashionGender, status])
}

// Per-user thumbs up/down on a seasonal colour — mirrors TrendFeedback
// exactly. Deliberately NOT shared across users: a personal preference, not
// a correction to the shared colour data itself.
model ColorFeedback {
  id             String   @id @default(cuid())
  supabaseUserId String
  fashionGender  String
  colorNameKey   String
  feedback       String // 'up' | 'down'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supabaseUserId, fashionGender, colorNameKey])
  @@index([supabaseUserId, fashionGender])
}
